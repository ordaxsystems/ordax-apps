    {"id":"studio.preview-validation","goal":"Confirmar o estado do preview e validar a superfície web do projeto sem capturar a janela errada.","allowedCapabilities":["project.preview_status","browser.snapshot","browser.screenshot"],"probeCapabilities":["project.preview_status"],"semanticElements":["preview.surface","preview.status"],"success":[{"kind":"element-present","element":"preview.surface"},{"kind":"element-present","element":"preview.status"},{"kind":"target-surface-evidence","surface":"managed-browser"}],"evidence":["semantic-snapshot","browser-snapshot","target-surface-screenshot"]},
    {"id":"studio.editor-structure","goal":"Confirmar que o editor expõe conteúdo, revisão e aplicação por identidade semântica estável.","allowedCapabilities":["workspace.text_read"],"probeCapabilities":[],"semanticElements":["editor.content","editor.review","editor.apply"],"success":[{"kind":"element-present","element":"editor.content"},{"kind":"element-present","element":"editor.review"},{"kind":"element-present","element":"editor.apply"}],"evidence":["semantic-snapshot"]}
  ]
