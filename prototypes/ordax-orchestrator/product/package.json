{
  "name": "ordax-orchestrator-lab",
  "version": "0.2.0-alpha.2",
  "private": true,
  "type": "module",
  "main": "desktop/bootstrap.mjs",
  "description": "Laboratorio isolado de orquestracao derivado do Flow/Gratis",
  "author": "OrdaX Systems",
  "scripts": {
    "check": "node scripts/check-source.mjs",
    "test": "node --test test/*.test.mjs",
    "validate": "npm run check && npm test",
    "start": "electron .",
    "build:win": "electron-builder --win portable",
    "test:live:ready": "node scripts/live-ui-readiness.cjs",
    "test:live:build-proof": "node scripts/live-ui-build-proof-readonly.cjs",
    "test:live:linked-thread": "node scripts/live-ui-linked-thread-smoke.cjs",
    "test:live:w3-offline-seed": "node scripts/seed-w3-unsubmitted-offline.cjs",
    "test:live:w3-offline-preflight": "node scripts/live-ui-w3-offline-preflight.cjs",
    "test:live:w4-offline-seed": "node scripts/seed-w4-offline-recovery.cjs",
    "dev:recovery-point": "node scripts/create-dev-recovery-point.cjs",
    "dev:stage-candidate": "node scripts/stage-runtime-candidate.cjs",
    "test:live:local-recovery": "node scripts/live-ui-local-recovery-readonly.cjs",
    "test:live:signed-out": "node scripts/live-ui-signed-out-compose.cjs",
    "test:live:provider-frame": "node scripts/live-ui-provider-frame-readonly.cjs",
    "test:live:text": "node scripts/live-ui-text-smoke.cjs",
    "test:live:continuity": "node scripts/live-ui-continuity-smoke.cjs",
    "test:live:restart": "node scripts/live-ui-restart-smoke.cjs",
    "test:live:image": "node scripts/live-ui-image-smoke.cjs",
    "test:live:history": "node scripts/live-ui-history-smoke.cjs",
    "test:live:stream": "node scripts/live-ui-stream-smoke.cjs"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "br.com.ordax.orchestrator.lab",
    "productName": "OrdaX Orchestrator Lab",
    "asar": true,
    "files": [
      "desktop/**/*",
      "src/*.mjs",
      "supervisor/**/*",
      "package.json",
      "runtime-build.json"
    ],
    "directories": {
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "OrdaX-Orchestrator-Lab-${version}.exe",
      "executableName": "OrdaX Orchestrator Lab"
    },
    "compression": "normal",
    "npmRebuild": false,
    "afterPack": "./scripts/attest-packaged-asar.cjs"
  }
}
