{
  "name": "@ordax/orchestrator-lab-bootstrap",
  "private": true,
  "version": "0.2.0-alpha.1",
  "type": "module",
  "description": "Bootstrap isolado do OrdaX Orchestrator Lab a partir de snapshot pinado do Flow/Grátis.",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "validate": "npm run version:check && npm test",
    "import:flow": "node scripts/import-flow.mjs",
    "start": "node scripts/start-lab.mjs",
    "version:check": "node scripts/verify-version.mjs",
    "start:staged": "node scripts/start-lab.mjs --staged",
    "version:show": "node scripts/verify-version.mjs"
  }
}
