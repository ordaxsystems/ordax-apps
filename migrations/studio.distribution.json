{
  "$schema": "ordax-apps.studio-distribution/1",
  "product": {
    "app_id": "studio",
    "name": "ORDAX Studio",
    "single_portable_source": true,
    "provider_neutral": true,
    "portable_source": "apps/studio"
  },
  "release_versioning": {
    "single_app_version": true,
    "current_transitional_source": "apps/studio/app.json#version",
    "source_after_cutover": "apps/studio/app.json#version",
    "windows_consumes_canonical_app_version": true,
    "ordax_os_consumes_canonical_app_version": true,
    "target_specific_feature_versions_forbidden": true,
    "target_build_metadata_allowed": true,
    "legacy_version_source_allowed": false
  },
  "targets": {
    "ordax_os": {
      "supported": true,
      "distribution_kind": "first-party-app-component",
      "portable_source": "apps/studio",
      "host_adapter": "ordax-os",
      "runtime_owner": "ordax-os-platform",
      "bundles_ordax_runtime": false,
      "uses_platform_ports": true,
      "standalone_from_windows_host": true
    },
    "windows": {
      "supported": true,
      "distribution_kind": "standalone-desktop-product",
      "portable_source": "apps/studio",
      "host_adapter": "windows",
      "runtime_owner": "ordax-runtime-windows",
      "bundles_ordax_runtime": true,
      "runtime_product_name": "ORDAX Runtime",
      "launcher_name": "ORDAX Studio.exe",
      "installer_name_pattern": "ORDAX-Studio-Setup-<version>-x64.exe",
      "requires_ordax_os": false,
      "account_optional_for_local_use": true,
      "cloud_pairing_optional_for_local_use": true,
      "offline_local_launch_supported": true,
      "local_device_identity_account_independent": true,
      "account_connection_extends_remote_capabilities_only": true,
      "computer_control_modes": [
        "bounded",
        "full-access"
      ],
      "full_access_owner_approval_local_only": true,
      "remote_client_cannot_enable_full_access": true,
      "full_access_removes_ordax_root_and_app_allowlists": true,
      "full_filesystem_intermediate_mode_supported": true,
      "windows_uac_remains_final_platform_boundary": true,
      "remote_full_access_gate": {
        "status": "implemented-validated",
        "device_scoped": true,
        "project_id_nullable_for_device_control": true,
        "derived_from_authenticated_subject_and_active_device_link": true,
        "operator_token_not_required_for_normal_owner_use": true,
        "model_callable_grant_mint_forbidden": true,
        "local_full_access_consent_required": true,
        "legacy_operator_only_project_grant_is_not_product_path": true,
        "evidence": {
          "studio_commit": "f279ebd996a9ee5cdbbd75912dfa5109e91ad3cc",
          "runtime_commit": "435699d30471b8aa1c5080d08be554a23f15a896",
          "control_plane_commit": "124630ee55367ac8fbe2debc8d9ba8545b0915c0",
          "windows_product_build_run": 37536311885
        }
      }
    }
  },
  "shared_release_invariants": {
    "same_portable_product_source": true,
    "same_portable_ui_semantics": true,
    "same_public_port_contracts": true,
    "same_typed_action_semantics": true,
    "same_provider_neutral_core": true,
    "same_canonical_app_version": true,
    "windows_local_first_semantics": true,
    "windows_full_access_is_host_policy_not_portable_authority": true,
    "remote_full_access_must_use_runtime_v2_device_scope": true,
    "os_specific_forks_forbidden": true,
    "provider_specific_forks_forbidden": true,
    "raw_device_execute_in_portable_app_forbidden": true,
    "runtime_implementation_in_portable_app_forbidden": true
  },
  "allowed_target_specific_code": {
    "ordax_os": [
      "platform port composition",
      "OrdaX OS package metadata",
      "OrdaX OS lifecycle integration"
    ],
    "windows": [
      "Windows host adapter",
      "ORDAX Runtime packaging",
      "Windows installer and launcher integration",
      "Windows process/service lifecycle",
      "Windows Computer Control policy and owner-approved Full Access",
      "Windows device-scoped remote authorization adapter"
    ]
  },
  "outside_studio_core": [
    "Identity and device pairing authority",
    "Computer Control policy authority",
    "Control Plane implementation",
    "provider connectors",
    "Blender and Unity execution adapters",
    "package install/update/rollback authority"
  ],
  "parity_proofs_required_before_cutover": [
    "ordax-os-adapter-conformance",
    "windows-adapter-conformance",
    "portable-core-identical-inputs",
    "typed-action-semantic-parity",
    "canonical-app-version-parity",
    "provider-neutral-core",
    "windows-local-first-no-account-offline",
    "windows-owner-approved-full-access",
    "windows-full-access-device-scoped-remote",
    "windows-clean-install-upgrade-uninstall",
    "ordax-os-install-stage-health-promote-rollback"
  ],
  "cutover_allowed": false,
  "authority": "none",
  "migration_repositories": {
    "portable_app": "ordaxsystems/ordax-apps",
    "windows_runtime": "ordaxsystems/ordax-runtime",
    "control_plane": "ordaxsystems/ordax-control-plane"
  },
  "legacy_repository": {
    "repository": "washingtonmsdj/mcp-blender",
    "role": "retirement-only",
    "may_source_portable_studio": false,
    "deletion_requires_runtime_and_control_plane_repoint": true
  }
}
