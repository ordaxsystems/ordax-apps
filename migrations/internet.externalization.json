{
  "$schema": "ordax.app-externalization-plan/1",
  "app_id": "internet",
  "source_repository_current": "ordaxsystems/ordax-os",
  "source_path_current": "system/apps/internet",
  "target_repository": "ordaxsystems/ordax-apps",
  "target_path": "apps/internet",
  "source_of_truth_state": "platform-until-cutover",
  "source_cutover_allowed": false,
  "distribution_activation_allowed": false,
  "source_cutover": {
    "mode": "remove-platform-first",
    "prelaunch_only": true,
    "temporary_app_absence_allowed": true,
    "dual_source_allowed": false,
    "platform_absence_proof_required_before_copy": true,
    "sdk_public_boundary_required_before_snapshot": true,
    "production_rule_after_first_user_data": "staged-handoff-no-data-loss"
  },
  "source_snapshot": {
    "state": "not-captured",
    "repository": "ordaxsystems/ordax-os",
    "commit": null,
    "inventory_file": null
  },
  "delivery": {
    "delivery_class": "bootstrap",
    "store_is_install_authority": false,
    "install_owner": "platform-component-lifecycle",
    "auto_install": false
  },
  "authority": "none",
  "runtime_boundary": {
    "application_ui_and_app_owned_state": "application",
    "webkitgtk_engine": "platform",
    "unprivileged_webview_isolation": "platform",
    "network_and_site_permission_policy": "platform",
    "native_download_storage_and_filesystem_security": "platform",
    "verified_install_update_rollback": "platform",
    "private_platform_source_imports_after_cutover_allowed": false,
    "second_web_engine_in_app_allowed": false
  },
  "target_sdk": {
    "minimum_bundle_version": "1.14.0",
    "lock_file": "platform-sdk.lock.json",
    "required_boundary": "browser-contracts-from-published-bundle",
    "migration_authorized_by_sdk_pin": false
  }
}
