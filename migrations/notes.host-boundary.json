{
  "$schema": "ordax.notes-host-boundary/1",
  "app_id": "notes",
  "target_source": "apps/notes",
  "host_object": "ordaxNotesHost",
  "injection_owner": "ordax-platform-host",
  "portable_app_authority": "none",
  "required_facets": {
    "appData": {
      "contract": "ordax.app-data/1",
      "required_for_distribution": true
    },
    "appActivation": {
      "contract": "ordax.app-activation/1",
      "required_for_distribution": true
    },
    "fileSpace": {
      "contract": "ordax.file-space/11",
      "required_for_distribution": false
    },
    "intelligence": {
      "contract": "ordax.intelligence/1",
      "required_for_distribution": false
    },
    "localization": {
      "contract": "ordax.localization/1",
      "required_for_distribution": true
    },
    "surfaceLifecycle": {
      "contract": "ordax.surface-render-lifecycle/4",
      "required_for_distribution": true
    }
  },
  "component_contracts": {
    "manifest": "ordax.component-manifest/1",
    "runtime": "ordax.component-runtime/1"
  },
  "app_owned_contracts": [
    "notes-store",
    "notes-file-importer"
  ],
  "forbidden": {
    "platform_private_imports": true,
    "system_contract_path_imports": true,
    "legacy_createStore_injection": true,
    "legacy_native_notes_endpoint": true,
    "raw_native_storage_path": true,
    "install_authority_in_app": true,
    "store_authority_in_app": true
  },
  "data": {
    "durable_owner": "ordax.app-data/1",
    "legacy_seed_required": false,
    "uninstall_payload_and_user_data_are_separate": true
  },
  "host_parity": {
    "same_port_semantics_web_native": true,
    "host_specific_transport_outside_app": true,
    "app_source_fork_by_host_forbidden": true
  },
  "authority": "none"
}
