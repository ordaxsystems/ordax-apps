{
  "$schema": "ordax.app-externalization-plan/1",
  "app_id": "notes",
  "source_repository_current": "washingtonmsdj/prototipo-ordax-os",
  "source_path_current": "system/apps/notes",
  "target_repository": "washingtonmsdj/ordax-apps",
  "target_path": "apps/notes",
  "source_of_truth_state": "platform-until-cutover",
  "cutover_allowed": false,
  "platform_contracts_required": [
    "ordax.app-activation/1",
    "ordax.app-data/1",
    "ordax.component-manifest/1",
    "ordax.component-runtime/1",
    "ordax.file-space/11",
    "ordax.intelligence/1",
    "ordax.localization/1",
    "prototype-ordax.localization-pack/1",
    "ordax.surface-render-lifecycle/4"
  ],
  "target_sdk": {
    "minimum_bundle_version": "1.6.0",
    "reason": "ordax.app-data/1 is required for external durable Notes state"
  },
  "app_owned_contracts": [
    "notes-store",
    "notes-file-importer"
  ],
  "resolved_dependencies": [
    {
      "source": "system/apps/notes/ui/workspace-controls.mjs",
      "former_dependency": "system/services/intelligence/client-actions.mjs",
      "replacement": "system/apps/notes/platform/intelligence-summary.mjs over injected ordax.intelligence/1 port",
      "verified_platform_commit": "4229f9e381203a09036bff7955bd87ea971cf231"
    }
  ],
  "private_dependencies_to_remove": [],
  "source_couplings_to_remove": [
    {
      "source": "system/apps/catalog.mjs",
      "dependency": "system/apps/notes/app.mjs",
      "replacement": "product catalog metadata independent from implementation source"
    },
    {
      "source": "system/apps/component-catalog.mjs",
      "dependency": "system/apps/notes/component.mjs",
      "replacement": "verified package/inventory component manifest"
    }
  ],
  "storage_migration": {
    "current_runtime_injection": "createStore",
    "target_contract": "ordax.app-data/1",
    "state": "blocked-pending-runtime-port-cutover",
    "data_owner": "notes",
    "cutover_mode": "clean-prelaunch",
    "production_user_data_present": false,
    "legacy_seed_required": false,
    "legacy_payload_may_be_discarded_at_cutover": true,
    "uninstall_data_separation_required": true
  },
  "proofs_required": [
    "sdk-contracts-pinned",
    "no-core-private-imports",
    "external-deterministic-package",
    "platform-package-verification",
    "install-stage-health-promote",
    "rollback-last-known-good",
    "platform-operates-without-app",
    "offline-reinstall-from-local-artifact",
    "uninstall-preserves-user-data",
    "old-platform-source-removed"
  ],
  "authority": "none",
  "delivery": {
    "delivery_class": "on-demand",
    "discovery": "store-only",
    "store_is_install_authority": false,
    "install_owner": "platform-component-lifecycle",
    "pre_store_delivery": "official-signed-stable-release",
    "auto_install": false
  },
  "source_cutover": {
    "mode": "remove-platform-first",
    "prelaunch_only": true,
    "temporary_app_absence_allowed": true,
    "dual_source_allowed": false,
    "platform_absence_proof_required_before_copy": true,
    "package_lifecycle_proof_runs_after_source_cutover": true,
    "production_rule_after_first_user_data": "staged-handoff-no-data-loss"
  },
  "gate_a_platform_removal": {
    "remove_owned_source": [
      "system/apps/notes/**",
      "system/contracts/notes-store.mjs",
      "system/contracts/notes-file-importer.mjs"
    ],
    "remove_legacy_adapters": [
      "system/adapters/native/notes.mjs",
      "system/adapters/web/notes.mjs"
    ],
    "remove_platform_implementation_couplings": [
      "system/apps/catalog.mjs -> ./notes/app.mjs",
      "system/apps/component-catalog.mjs -> ./notes/component.mjs",
      "system/composition/native/main.mjs -> ../../apps/notes/runtime.mjs",
      "system/composition/web/main.mjs -> ../../apps/notes/runtime.mjs"
    ],
    "remove_legacy_native_state": [
      "/__ordax/native/notes",
      "/var/lib/ordax/notes.json"
    ],
    "remove_fixed_launch_paths": [
      "desktop rail Notes shortcut",
      "Surface/browser smoke assumptions that Notes payload is present"
    ],
    "retain_platform_owned": [
      "first-party delivery policy for notes",
      "signed catalog/store discovery metadata",
      "ordax.app-data/1 owner and verified install binding",
      "owner-managed Notes App Data quota policy",
      "generic component lifecycle/trust/probation infrastructure"
    ],
    "required_proofs": [
      "notes-not-in-installed-app-catalog",
      "notes-not-in-installed-component-catalog",
      "no-local-notes-runtime-import",
      "no-legacy-notes-endpoint",
      "no-fixed-notes-launcher",
      "platform-boots-with-notes-absent",
      "notes-remains-on-demand-store-only-product"
    ]
  }
}
